{
  "catalogVersion": 9,
  "tools": [
    {
      "name": "list_agent_requests",
      "description": "List your own queued agent requests in an explicit workspace, oldest first. No Project or journal session is required. Agent kind is advisory routing, never authorization. Read source text with read_comment_thread; requests do not authorize arbitrary execution.",
      "webMethod": "mcp_list_agent_requests",
      "requiredScopes": ["notes:read", "journal:read"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "projectUuid": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "type": "string", "enum": ["OPEN", "PICKED_UP", "RESOLVED", "DISMISSED"] },
          "targetAgentKind": { "type": "string", "enum": ["claude", "codex"] },
          "cursor": { "type": "string", "maxLength": 2048 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false,
        "required": ["workspaceId"]
      }
    },
    {
      "name": "claim_agent_request",
      "description": "Claim one of your own OPEN requests using a caller-minted, retry-stable claimUuid. No Project or journal session is required. Same-claim retries replay; another claim conflicts. Returns only a mutation receipt.",
      "webMethod": "mcp_claim_agent_request",
      "requiredScopes": ["journal:write"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestUuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "claimUuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "additionalProperties": false,
        "required": ["workspaceId", "requestUuid", "claimUuid"]
      }
    },
    {
      "name": "resolve_agent_request",
      "description": "Resolve or dismiss your claimed request using the exact accepted claimUuid. Post the reply through reply_comment and confirm its delivery before resolving. Returns only a mutation receipt.",
      "webMethod": "mcp_resolve_agent_request",
      "requiredScopes": ["journal:write"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestUuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "claimUuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "disposition": { "type": "string", "enum": ["resolved", "dismissed"] }
        },
        "additionalProperties": false,
        "required": ["workspaceId", "requestUuid", "claimUuid", "disposition"]
      }
    }
  ]
}
